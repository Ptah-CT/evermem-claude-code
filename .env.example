# Required self-hosted EverMemOS endpoint and stable user identity.
EVERMEM_API_URL=http://evermem-host:1995
EVERMEM_USER_ID=your-user-id

# HIER STAND EVERMEM_REQUEST_TIMEOUT_MS. Ersatzlos entfernt am 2026-09-09.
#
# Es gibt auf diesem Pfad keine Frist, und es soll keine geben: Entweder der
# Aufruf funktioniert — in der dafür nötigen Zeit — oder es existiert ein
# Fehler. Eine Frist erfindet einen dritten Ausgang ("hat zu lange gedauert"),
# der weder Erfolg noch Fehler ist und beide verdeckt. Gemessen: 17 von 48 so
# gemeldeten Fehlschlägen lagen in Wahrheit im Speicher — die Frist hat
# gelungene Arbeit als gescheitert gemeldet.
#
# Wer hier wieder eine Zahl einziehen will, begründet zuerst den dritten
# Ausgang. Die vollständige Herleitung steht in config.js und evermem-api.js.

# Optional: use one global memory group instead of per-project groups.
EVERMEM_DISABLE_PROJECT_SCOPE=1

# Optional: emit hook diagnostics to stderr (captured by the host journal/logs).
# EVERMEM_DEBUG=1
